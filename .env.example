# CloudForge — environment template (Milestone 1)
# Copy to `.env` and fill in the secrets. NEVER commit a real `.env`,
# and NEVER put real secrets in this file.
#
#   cp .env.example .env

# --- Mode: lite or full (default full) -------------------------------
# lite  = classroom laptop: 2–4 cores / 4 GB RAM, no KVM needed.
#         `make up-lite` / docker-compose.light.yml. Trimmed stack
#         (no Prometheus/Grafana/MinIO), tuned-down Postgres/Redis,
#         simulated networking, 1 lab / Micro profile only, 30 min.
# full  = lab server: 8+ cores / 24–32 GB RAM, KVM VMs, Terraform
#         containers, real netlink, monitoring + MinIO.
#         `make up` / docker-compose.yml. This is the default —
#         leaving this unset (or =full) changes nothing.
# CLOUDFORGE_MODE=lite|full. CLOUDFORGE_LITE=true is accepted as
# an alias for MODE=lite; setting both to different modes is a
# startup error. See docs/operations/lightweight.md.
CLOUDFORGE_MODE=full
# CLOUDFORGE_LITE=true

# --- API ---------------------------------------------------------------
API_PORT=8080
# Public URL of the Go API as seen by the browser (baked into the
# frontend image at build time). Leave empty for the default
# same-origin deployment: the browser uses relative URLs through the
# nginx proxy (M9). Set it only for a split deployment where the API
# lives on another origin.
VITE_API_URL=
# gRPC address of the Rust network engine, as seen from the api container.
NETWORK_ENGINE_ADDR=network-engine:50051

# --- Auth --------------------------------------------------------------
# CHANGE ME: long random string, e.g. `openssl rand -hex 32`.
# Used to sign user session tokens (HS256 JWT). The variable name is
# CLOUDFORGE_JWT_SECRET (M9 renamed it from JWT_SECRET: the old name
# was never read by config and silently fell back to the dev default).
CLOUDFORGE_JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# Auth rate limit: attempts per window per client IP (defaults 10 / 5m).
# CLOUDFORGE_AUTH_RATE_LIMIT=10
# CLOUDFORGE_AUTH_RATE_WINDOW=5m
# General API rate limit: requests per window per client IP (defaults 300 / 1m).
# CLOUDFORGE_API_RATE_LIMIT=300
# CLOUDFORGE_API_RATE_WINDOW=1m

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=cloudforge
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=cloudforge
# Dev-only published port (see docker-compose.dev.yml).
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------
# Address of Redis as seen from the api container (config reads
# REDIS_ADDR; the old REDIS_URL name was never read). Published port
# for local dev is REDIS_PORT.
REDIS_ADDR=redis:6379
REDIS_PORT=6379

# --- Frontend ----------------------------------------------------------
FRONTEND_PORT=80

# --- MinIO (optional profile, M5) --------------------------------------
MINIO_ROOT_USER=cloudforge
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_8_chars
MINIO_ENDPOINT=http://minio:9000

# --- AWS emulator (M5, not wired in M1) --------------------------------
# AWS_EMULATOR_ENDPOINT=http://aws-emulator:4566
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

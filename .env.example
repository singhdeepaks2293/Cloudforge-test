# CloudForge — environment template (Milestone 1)
# Copy to `.env` and fill in the secrets. NEVER commit a real `.env`,
# and NEVER put real secrets in this file.
#
#   cp .env.example .env

# --- Mode: lite or full (default full) -------------------------------
# lite  = classroom laptop: 2–4 cores / 4 GB RAM, no KVM needed.
#         `make up-lite` / docker-compose.light.yml. Trimmed stack
#         (no Prometheus/Grafana/MinIO), tuned-down Postgres/Redis,
#         simulated networking, 1 lab / Micro profile only, 30 min.
# full  = lab server: 8+ cores / 24–32 GB RAM, KVM VMs, Terraform
#         containers, real netlink, monitoring + MinIO.
#         `make up` / docker-compose.yml. This is the default —
#         leaving this unset (or =full) changes nothing.
# CLOUDFORGE_MODE=lite|full. CLOUDFORGE_LITE=true is accepted as
# an alias for MODE=lite; setting both to different modes is a
# startup error. See docs/operations/lightweight.md.
CLOUDFORGE_MODE=full
# CLOUDFORGE_LITE=true

# --- API ---------------------------------------------------------------
API_PORT=8081
# Public URL of the Go API as seen by the browser (baked into the
# frontend image at build time). Leave empty for the default
# same-origin deployment: the browser uses relative URLs through the
# nginx proxy (M9). Set it only for a split deployment where the API
# lives on another origin.
VITE_API_URL=
# gRPC address of the Rust network engine, as seen from the api container.
NETWORK_ENGINE_ADDR=network-engine:50051

# --- Auth --------------------------------------------------------------
# CHANGE ME: long random string, e.g. `openssl rand -hex 32`.
# Used to sign user session tokens (HS256 JWT). The variable name is
# CLOUDFORGE_JWT_SECRET (M9 renamed it from JWT_SECRET: the old name
# was never read by config and silently fell back to the dev default).
CLOUDFORGE_JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# --- Phase 7: fail-closed secrets + engine/metrics auth ----------------
# The API and worker REFUSE TO START unless every secret below is
# set to a long random value (or CLOUDFORGE_DEV=1 is set — local
# development only, never on a shared host). There is no silent
# fallback to a dev default any more. Generate each with e.g.
#   openssl rand -hex 32
# Engine token: shared secret the Go control plane sends on every
# gRPC call to the Rust network engine (x-cloudforge-engine-token).
# The engine refuses unauthenticated calls, and :50051 is no longer
# published on the host by either compose file.
CLOUDFORGE_ENGINE_TOKEN=<change-me: openssl rand -hex 32>
# Metrics token: Prometheus scrapes GET /metrics with this token
# (Authorization: Bearer or X-Metrics-Token). nginx no longer
# proxies /metrics at all.
CLOUDFORGE_METRICS_TOKEN=<change-me: openssl rand -hex 32>
# Dev opt-in: ONLY for local development. With CLOUDFORGE_DEV=1 the
# well-known dev defaults (JWT dev default, engine token,
# host-agent token) are allowed and the API logs a loud warning.
# Never set this on a shared host.
# CLOUDFORGE_DEV=1
# TLS: set CLOUDFORGE_TLS=1 when the stack sits behind the TLS
# termination in deployments/compose/docker-compose.tls.yml (HSTS
# is emitted and session cookies are marked Secure). HTTP-only is
# the local-dev default.
# CLOUDFORGE_TLS=1
# Trusted proxies: extra peer IPs/CIDRs whose X-Forwarded-For the
# API trusts for rate limiting (loopback + private addresses are
# always trusted — the nginx container). Leave unset normally.
# CLOUDFORGE_TRUSTED_PROXIES=
# Per-user API rate limit (in addition to the per-IP limit):
# defaults 300 requests / 1m per user.
# CLOUDFORGE_API_USER_RATE_LIMIT=300
# CLOUDFORGE_API_USER_RATE_WINDOW=1m
# Audit export retention: how many audit-export job files are kept
# (default 7). The worker also archives >90-day audit rows to CSV
# before deleting them.
# CLOUDFORGE_AUDIT_EXPORT_RETENTION=7
# Terraform container network mode: bridge (default — the container
# can reach the emulator via host.docker.internal) or isolated
# (--network none: no egress at all, not even the emulator).
# CLOUDFORGE_TF_NETWORK_MODE=bridge
# Grafana admin password (monitoring profile): compose refuses to
# start the profile without it — there is no admin/admin default.
GRAFANA_ADMIN_PASSWORD=<change-me: openssl rand -hex 16>
# Auth rate limit: attempts per window per client IP (defaults 10 / 5m).
# CLOUDFORGE_AUTH_RATE_LIMIT=10
# CLOUDFORGE_AUTH_RATE_WINDOW=5m
# General API rate limit: requests per window per client IP (defaults 300 / 1m).
# CLOUDFORGE_API_RATE_LIMIT=300
# CLOUDFORGE_API_RATE_WINDOW=1m

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=cloudforge
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=cloudforge
# Dev-only published port (see docker-compose.dev.yml).
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------
# Address of Redis as seen from the api container (config reads
# REDIS_ADDR; the old REDIS_URL name was never read). Published port
# for local dev is REDIS_PORT.
REDIS_ADDR=redis:6379
REDIS_PORT=6379

# --- Frontend ----------------------------------------------------------
FRONTEND_PORT=8080

# --- MinIO (optional profile, M5) --------------------------------------
MINIO_ROOT_USER=cloudforge
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_8_chars
MINIO_ENDPOINT=http://minio:9000

# --- AWS emulator (M5, not wired in M1) --------------------------------
# AWS_EMULATOR_ENDPOINT=http://aws-emulator:4566
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# --- Phase 4: ECR + CodeBuild/CodePipeline sources ----------------------
# ECR registry backend. Empty = local-disk registry (Postgres catalogue
# + content-addressed blobs under the workdir root). Set to the
# registry:2 container to proxy push/pull to it (full compose sets
# this to http://registry:5000 when the `optional` profile runs the
# registry service). No auth either way — local-only (Phase 7 item).
ECR_REGISTRY_URL=
# Root under which CodeBuild/CodePipeline source paths must live.
# Empty = the Terraform workdir root. Absolute paths only; remote
# (http/ssh/git@) sources are rejected.
CLOUDFORGE_BUILD_SOURCE_ROOT=

{"description":"CloudForge control-plane overview (Milestone 9, Part 3). Every panel queries a series the API actually exports on /metrics — see backend/internal/metrics. No panel invents a series: engine and host-agent health come from the cloudforge_network_engine_up / cloudforge_host_agent_up gauges, and lab/worker activity from the lab/job counters.","panels":[{"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"gridPos":{"h":8,"w":12,"x":0,"y":0},"id":1,"targets":[{"expr":"sum by (route) (rate(cloudforge_http_requests_total[5m]))","legendFormat":"{{route}}","refId":"A"}],"title":"API request rate (req/s by route)","type":"timeseries"},{"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"gridPos":{"h":8,"w":12,"x":12,"y":0},"id":2,"targets":[{"expr":"histogram_quantile(0.50, sum by (le) (rate(cloudforge_http_request_duration_seconds_bucket[5m])))","legendFormat":"p50","refId":"A"},{"expr":"histogram_quantile(0.95, sum by (le) (rate(cloudforge_http_request_duration_seconds_bucket[5m])))","legendFormat":"p95","refId":"B"}],"title":"API latency p50 / p95 (seconds)","type":"timeseries"},{"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"gridPos":{"h":8,"w":8,"x":0,"y":8},"id":3,"targets":[{"expr":"sum(rate(cloudforge_http_requests_total{status=~\"5..\"}[5m]))","legendFormat":"5xx","refId":"A"}],"title":"API 5xx rate (req/s)","type":"timeseries"},{"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"red","value":0},{"color":"green","value":1}]},"unit":"none"},"overrides":[]},"gridPos":{"h":8,"w":8,"x":8,"y":8},"id":4,"targets":[{"expr":"cloudforge_network_engine_up","refId":"A"}],"title":"Network engine up (1 = gRPC Health ok)","type":"stat"},{"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"red","value":0},{"color":"green","value":1}]},"unit":"none"},"overrides":[]},"gridPos":{"h":8,"w":8,"x":16,"y":8},"id":5,"targets":[{"expr":"cloudforge_host_agent_up","refId":"A"}],"title":"Host agent up (1 = /healthz ok, 0 = down or unconfigured)","type":"stat"},{"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"permin"},"overrides":[]},"gridPos":{"h":8,"w":12,"x":0,"y":16},"id":6,"targets":[{"expr":"sum by (result) (rate(cloudforge_jobs_total[5m]) * 60)","legendFormat":"{{result}}","refId":"A"}],"title":"Worker jobs (per min by result)","type":"timeseries"},{"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"permin"},"overrides":[]},"gridPos":{"h":8,"w":12,"x":12,"y":16},"id":7,"targets":[{"expr":"sum by (event) (rate(cloudforge_lab_events_total[5m]) * 60)","legendFormat":"{{event}}","refId":"A"}],"title":"Lab events (per min)","type":"timeseries"}],"refresh":"30s","schemaVersion":39,"tags":["cloudforge"],"time":{"from":"now-1h","to":"now"},"timezone":"browser","title":"CloudForge overview","uid":"cloudforge-overview","version":1}
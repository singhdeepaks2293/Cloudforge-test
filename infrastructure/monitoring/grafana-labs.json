{"description":"Lab lifecycle and worker activity (Milestone 9, Part 3). Panels query only series the API/worker export: cloudforge_lab_events_total, cloudforge_jobs_total, and the engine/host-agent up gauges. There is no per-lab gauge yet — lab counts come from the API (GET /api/v1/labs), not from Prometheus — so this dashboard shows event and job rates, not a live lab inventory.","panels":[{"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"permin"},"overrides":[]},"gridPos":{"h":8,"w":12,"x":0,"y":0},"id":1,"targets":[{"expr":"sum by (event) (rate(cloudforge_lab_events_total[5m]) * 60)","legendFormat":"{{event}}","refId":"A"}],"title":"Labs created vs destroyed (per min)","type":"timeseries"},{"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"permin"},"overrides":[]},"gridPos":{"h":8,"w":12,"x":12,"y":0},"id":2,"targets":[{"expr":"sum by (type) (rate(cloudforge_jobs_total[5m]) * 60)","legendFormat":"{{type}}","refId":"A"}],"title":"Worker jobs by type (per min)","type":"timeseries"},{"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"permin"},"overrides":[]},"gridPos":{"h":8,"w":12,"x":0,"y":8},"id":3,"targets":[{"expr":"sum by (type, result) (rate(cloudforge_jobs_total{result=~\"failed|dead\"}[5m]) * 60)","legendFormat":"{{type}} {{result}}","refId":"A"}],"title":"Failed / dead-lettered jobs (per min)","type":"timeseries"},{"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"gridPos":{"h":8,"w":12,"x":12,"y":8},"id":4,"targets":[{"expr":"histogram_quantile(0.95, sum by (le, route) (rate(cloudforge_http_request_duration_seconds_bucket{route=~\"/api/v1/labs.*\"}[5m])))","legendFormat":"{{route}}","refId":"A"}],"title":"Lab API latency p95 (seconds, /api/v1/labs routes)","type":"timeseries"},{"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"red","value":0},{"color":"green","value":1}]},"unit":"none"},"overrides":[]},"gridPos":{"h":8,"w":24,"x":0,"y":16},"id":5,"targets":[{"expr":"cloudforge_network_engine_up","legendFormat":"engine","refId":"A"},{"expr":"cloudforge_host_agent_up","legendFormat":"host-agent","refId":"B"}],"title":"Engine + host-agent health","type":"stat"}],"refresh":"30s","schemaVersion":39,"tags":["cloudforge","labs"],"time":{"from":"now-3h","to":"now"},"timezone":"browser","title":"CloudForge labs","uid":"cloudforge-labs","version":1}
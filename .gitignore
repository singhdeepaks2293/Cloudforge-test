# .gitignore — CloudForge
# Secrets and local config
.env
.env.local
*.pem
*.key
credentials*.json

# Build outputs
node_modules/
dist/
build/
target/
__pycache__/
*.pyc

# Go / Rust
*.test
*.out

# Terraform / local state (never commit real state)
*.tfstate
*.tfstate.backup
.terraform/

# VM disks, templates and lab data (large, host-local)
*.qcow2
*.img
*.iso

# IDE / OS
.idea/
.vscode/
.DS_Store
